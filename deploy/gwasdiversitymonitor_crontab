# /etc/cron.d/gwasdiversitymonitor_crontab: daily GWAS data collection.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/bin/python3
# m h dom mon dow user  command
@daily ubuntu cd /opt/gwasdiversitymonitor && /usr/bin/docker compose --project-directory /opt/gwasdiversitymonitor --file /opt/gwasdiversitymonitor/docker-compose.yml up --detach --build --force-recreate data
