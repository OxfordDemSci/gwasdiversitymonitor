# Copy this file to .env on the production server. Docker Compose reads .env
# automatically; .env is gitignored. No mail credentials are required.
# Leave this blank on every machine except the canonical production server.
# On that server only, set it to: gwasdiversitymonitor.com
GWAS_DEPLOYMENT_DOMAIN=

# Set to 1 on public development or staging deployments. Production should
# leave this blank so search engines may index the canonical site.
GWAS_NOINDEX=

GWAS_FAILURE_EMAIL_FROM=alerts@mail.gwasdiversitymonitor.com
GWAS_FAILURE_EMAIL_TO=contact@gwasdiversitymonitor.com

# Suppress repeat messages for the same consecutive failure for six hours.
# A different failure alerts immediately, and a successful run clears this.
GWAS_FAILURE_EMAIL_COOLDOWN_SECONDS=21600
